# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto.
# O `.env.local` não é versionado (contém as chaves).

# ── Supabase (obrigatório) ───────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# O código lê NEXT_PUBLIC_SUPABASE_ANON_KEY; a chave "publishable" nova do
# Supabase entra aqui (é a chave pública, segura para o cliente).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── URL pública da aplicação (opcional) ──────────────────────────────────────
# Usada nos links que saem daqui (confirmação de cadastro, convites). Sem ela,
# o link é montado a partir do host da requisição — o que já funciona em
# desenvolvimento. Em produção, preencha com o domínio final.
NEXT_PUBLIC_SITE_URL=

# ── Envio de e-mail (opcional) ───────────────────────────────────────────────
# Sem estas duas variáveis os convites continuam funcionando: o link e o código
# aparecem na tela para quem convidou copiar e mandar pelo canal que quiser.
# Com elas, o convite sai por e-mail automaticamente.
# Chave em https://resend.com → API Keys
RESEND_API_KEY=
# Remetente verificado no provedor, ex.: "Folium <convites@seudominio.com>"
EMAIL_FROM=
